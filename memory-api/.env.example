# AI Memory Server — Environment Configuration

# -----------------------------------------------------------------------------
# Elasticsearch Configuration
# -----------------------------------------------------------------------------
ES_URL=http://localhost:9200
ES_INDEX=agent_memory
ES_TIMEOUT=10
ES_MAX_RETRIES=5
ES_RETRY_BACKOFF=1.0

# Optional authentication / TLS for Elasticsearch (leave empty for local dev).
# Set these when your cluster requires credentials and/or HTTPS.
ES_USERNAME=
ES_PASSWORD=
# Path to a PEM CA bundle used to verify the Elasticsearch TLS certificate.
ES_CA_CERTS=
# Verify the Elasticsearch TLS certificate (set to false only for self-signed
# development clusters).
ES_VERIFY_CERTS=true

# -----------------------------------------------------------------------------
# REST API Configuration
# -----------------------------------------------------------------------------
# Bind to loopback by default. In production, keep the API on loopback and let a
# TLS-terminating reverse proxy expose it; do not bind 0.0.0.0 without TLS.
API_HOST=127.0.0.1
API_PORT=8000
MAX_BODY_BYTES=1000000

# -----------------------------------------------------------------------------
# Security & Multi-Tenancy Authentication
# -----------------------------------------------------------------------------
# AUTH_MODE options:
#   disabled : Local development only (no token check; tenant/user still scoped)
#   token    : Production-like token auth. Must provide Authorization: Bearer <token>
AUTH_MODE=disabled

# Token definitions (format: TOKEN:tenant/user,TOKEN2:tenant2/*)
# Use '*' for user to allow any user within that tenant.
# The tenant is REQUIRED: the server refuses to start in token mode if any entry
# has an empty tenant (a tenant-less token would grant cross-tenant access).
# Provide real tokens via the environment or a secret manager; never commit them.
API_TOKENS=sec-demo-tok:demo/user_001,sec-agent-tok:demo/*,sec-acme-tok:acme/*

# -----------------------------------------------------------------------------
# Lifecycle & Deduplication Settings
# -----------------------------------------------------------------------------
FUZZY_DEDUP_ENABLED=true
FUZZY_THRESHOLD=0.9
CONFLICT_THRESHOLD=0.4
MIN_CONTENT_CHARS=3

# -----------------------------------------------------------------------------
# Search & Ranking Boosts
# -----------------------------------------------------------------------------
DEFAULT_LIMIT=5
MAX_LIMIT=50
BOOST_IMPORTANCE=1.0
BOOST_CONFIDENCE=0.5
BOOST_RECENCY=0.3

# -----------------------------------------------------------------------------
# Embeddings & Vector Search
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER options:
#   hash                 : Local zero-dependency deterministic encoder (dev/testing)
#   sentence-transformers: Real local semantic embeddings (requires sentence-transformers)
#   none                 : Disables vector search (keyword search only)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMS=384
EMBEDDING_MODEL=all-MiniLM-L6-v2
HYBRID_KEYWORD_WEIGHT=0.6
HYBRID_VECTOR_WEIGHT=0.4

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) Server
# -----------------------------------------------------------------------------
# MCP_TRANSPORT options: stdio | streamable-http
#   stdio            : Local, process-bound pipe. No network auth needed (default).
#   streamable-http  : Listens on TCP. REQUIRES bearer auth: it reuses API_TOKENS,
#                      so AUTH_MODE=token + a non-empty API_TOKENS are mandatory,
#                      and it refuses to start otherwise. Keep MCP_HOST on
#                      loopback and put a TLS reverse proxy in front for remote use.
MCP_TRANSPORT=stdio
# Bind address for the HTTP transport (loopback by default).
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Public base URL advertised in OAuth protected-resource metadata (optional).
# Defaults to the bound MCP_HOST:MCP_PORT. Set when behind a proxy, e.g.
# https://memory.example.com
MCP_PUBLIC_URL=
