# AI Memory Server — Environment Configuration

# -----------------------------------------------------------------------------
# Elasticsearch Configuration
# -----------------------------------------------------------------------------
ES_URL=http://localhost:9200
ES_INDEX=agent_memory
ES_TIMEOUT=10
ES_MAX_RETRIES=5
ES_RETRY_BACKOFF=1.0

# -----------------------------------------------------------------------------
# REST API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
MAX_BODY_BYTES=1000000

# -----------------------------------------------------------------------------
# Security & Multi-Tenancy Authentication
# -----------------------------------------------------------------------------
# AUTH_MODE options:
#   disabled : Local development only (no token check; tenant/user still scoped)
#   token    : Production-like token auth. Must provide Authorization: Bearer <token>
AUTH_MODE=disabled

# Token definitions (format: TOKEN:tenant/user,TOKEN2:tenant2/*)
# Use '*' for user to allow any user within that tenant.
API_TOKENS=sec-demo-tok:demo/user_001,sec-agent-tok:demo/*,sec-acme-tok:acme/*

# -----------------------------------------------------------------------------
# Lifecycle & Deduplication Settings
# -----------------------------------------------------------------------------
FUZZY_DEDUP_ENABLED=true
FUZZY_THRESHOLD=0.9
CONFLICT_THRESHOLD=0.4
MIN_CONTENT_CHARS=3

# -----------------------------------------------------------------------------
# Search & Ranking Boosts
# -----------------------------------------------------------------------------
DEFAULT_LIMIT=5
MAX_LIMIT=50
BOOST_IMPORTANCE=1.0
BOOST_CONFIDENCE=0.5
BOOST_RECENCY=0.3

# -----------------------------------------------------------------------------
# Embeddings & Vector Search
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER options:
#   hash                 : Local zero-dependency deterministic encoder (dev/testing)
#   sentence-transformers: Real local semantic embeddings (requires sentence-transformers)
#   none                 : Disables vector search (keyword search only)
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMS=384
EMBEDDING_MODEL=all-MiniLM-L6-v2
HYBRID_KEYWORD_WEIGHT=0.6
HYBRID_VECTOR_WEIGHT=0.4

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) Server
# -----------------------------------------------------------------------------
# MCP_TRANSPORT options: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_PORT=8001
